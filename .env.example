# Supabase Configuration (Required for Frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional Backend URL (defaults to http://localhost:5000 if not provided)
VITE_BACKEND_URL=http://localhost:5000

# Backend Credentials (used only by express backend server)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
STORE_ID=your-sslcommerz-store-id
STORE_PASSWORD=your-sslcommerz-store-password
