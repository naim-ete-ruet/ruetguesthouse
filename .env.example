# Frontend Environment Variables (Netlify Site Configuration)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Set this on Netlify to your deployed backend URL (e.g., https://your-backend.onrender.com)
VITE_BACKEND_URL=http://localhost:5000

# Backend Server Environment Variables (Render/Railway Configuration)
PORT=5000
FRONTEND_URL=https://ruetguesthouse.netlify.app
BACKEND_URL=https://your-backend.onrender.com
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
# Optional: On Render Free Tier, SMTP ports (25, 465, 587) are blocked by Render.
# To send emails over HTTPS (Port 443) on Render Free Tier, add a free API key from Brevo (brevo.com) or Resend (resend.com):
BREVO_API_KEY=your-brevo-api-key
# or
RESEND_API_KEY=your-resend-api-key

STORE_ID=your-sslcommerz-store-id
STORE_PASSWORD=your-sslcommerz-store-password
